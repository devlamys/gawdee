# Complete nonsecret baseline. Generate GAWDEE_APP_KEY before using it.
# This file is dotenv syntax; do not source it as a shell script.
ENVIRONMENT=staging
GAWDEE_STORAGE=/srv/gawdee/staging/shared/storage
GAWDEE_PUBLIC_DIR=/srv/gawdee/staging/shared/public
GAWDEE_APP_KEY=REPLACE_WITH_A_BASE64_32_BYTE_KEY
CORS_ORIGINS=https://staging.example.com
CORS_ORIGIN_REGEX=^$
SESSION_COOKIE_NAME=gawdee_session
SESSION_COOKIE_MAX_AGE_SECONDS=604800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_PATH=/
ADMIN_COOKIE_NAME=admin_token
ADMIN_TOKEN_TTL_SECONDS=604800
ADMIN_COOKIE_SAMESITE=lax
ADMIN_COOKIE_SECURE=true
CURRENCY=INR
CHECKOUT_MAX_ITEMS=50
CHECKOUT_MAX_QTY=20
STALE_ORDER_MINUTES=60
NOTIFICATION_BATCH_CHECKOUT=5
NOTIFICATION_BATCH_WEBHOOK=5
AI_CHAT_LIMIT=20
AI_CHAT_WINDOW_SECONDS=3600
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_MINUTES=15
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_CODE_DIGITS=6
ADMIN_TOP_PRODUCTS_LIMIT=10
ADMIN_RECENT_ORDERS_LIMIT=20
BLOG_LIST_LIMIT=20
RAZORPAY_API_BASE_URL=https://api.razorpay.com
DELHIVERY_PROD_TRACK_URL=https://track.delhivery.com
DELHIVERY_STAGING_TRACK_URL=https://staging-express.delhivery.com
DELHIVERY_PACKAGE_TRACK_URL=https://www.delhivery.com/track/package/
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
HTTP_TIMEOUT_SECONDS=20
AI_HTTP_TIMEOUT_SECONDS=90
DELHIVERY_HTTP_TIMEOUT_SECONDS=30
DB_BUSY_TIMEOUT_MS=10000
APP_TITLE=Gawdee API
APP_VERSION=1.0.0
APP_DESCRIPTION=Gawdee storefront API
HEALTH_SERVICE_NAME=gawdee-api
