[Unit]
Description=Gawdee %i backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gawdee-%i
Group=gawdee-%i
WorkingDirectory=/srv/gawdee/%i/current/backend
EnvironmentFile=/srv/gawdee/%i/shared/runtime.env
EnvironmentFile=/srv/gawdee/%i/shared/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/gawdee/%i/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${API_PORT} --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
