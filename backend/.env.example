# ── Gawdee FastAPI backend ───────────────────────────────────────────────
# Copy to `.env` and adjust per environment:  cp .env.example .env
#
# ALL variables below are REQUIRED — startup aborts (pydantic ValidationError)
# if any is missing. Defined in `app/core/config.py` (the ONLY place allowed
# to read the environment).
#
# Notes:
# • Relative paths resolve against the `backend/` directory.
# • There is NO `PORT` / `DATABASE_URL` / `JWT_SECRET` variable:
#   - port comes from the uvicorn CLI flag, e.g. `uvicorn app.main:app --port 8001`
#   - the database is SQLite at `<GAWDEE_STORAGE>/gawdee.sqlite`
#   - auth uses signed cookies keyed by `GAWDEE_APP_KEY` (no JWT)
# • Third-party SECRETS (Razorpay key id/secret, Delhivery API token, WhatsApp
#   tokens, Groq/OpenAI API keys, webhook secrets) are NOT env vars — they live
#   in the DB `settings` table and are managed via the admin panel. Only the
#   third-party endpoint *URLs* below are configured here.

# Runtime: development | staging | production
ENVIRONMENT=development

# ── Storage & secrets ────────────────────────────────────────────────────
# Directory holding gawdee.sqlite (+ .app_key). Created automatically.
GAWDEE_STORAGE=./storage
# Frontend static dir that receives uploaded assets (<dir>/assets/uploads/...).
GAWDEE_PUBLIC_DIR=../frontend/public
# Base64-encoded >=32-byte key for AES-GCM encryption + cookie signing.
# Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
GAWDEE_APP_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (credentials on).
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:3000
# Extra regex for local/LAN dev hosts (e.g. phone testing over 192.168.x.x).
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?

# ── Customer session cookie ──────────────────────────────────────────────
# Name of the signed session cookie.
SESSION_COOKIE_NAME=gawdee_session
# Session lifetime in seconds (604800 = 7 days).
SESSION_COOKIE_MAX_AGE_SECONDS=604800
# MUST be true in production behind HTTPS; false for local http:// dev.
SESSION_COOKIE_SECURE=false
# SameSite policy: lax | strict | none (none requires SECURE=true).
SESSION_COOKIE_SAMESITE=lax
# Keep true so JS cannot read the cookie (XSS mitigation).
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_PATH=/

# ── Admin auth ───────────────────────────────────────────────────────────
ADMIN_COOKIE_NAME=admin_token
# Admin token TTL in seconds (604800 = 7 days).
ADMIN_TOKEN_TTL_SECONDS=604800
ADMIN_COOKIE_SAMESITE=lax
# MUST be true in production behind HTTPS.
ADMIN_COOKIE_SECURE=false

# ── Commerce ─────────────────────────────────────────────────────────────
# ISO-4217 currency code used in pricing.
CURRENCY=INR
# Max distinct items / max qty per item accepted at checkout.
CHECKOUT_MAX_ITEMS=30
CHECKOUT_MAX_QTY=10
# Unpaid orders older than this (minutes) are treated as stale.
STALE_ORDER_MINUTES=45
# Order-notification batch sizes (checkout flow / webhook flow).
NOTIFICATION_BATCH_CHECKOUT=5
NOTIFICATION_BATCH_WEBHOOK=10

# ── Rate limits ──────────────────────────────────────────────────────────
# AI chat: max requests per window per client.
AI_CHAT_LIMIT=12
AI_CHAT_WINDOW_SECONDS=300
# Admin/customer login: max attempts per window before throttling.
LOGIN_MAX_ATTEMPTS=6
LOGIN_WINDOW_SECONDS=900

# ── OTP (phone login) ────────────────────────────────────────────────────
# Max OTP requests per window per phone number.
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_MINUTES=15
# How long an issued code stays valid.
OTP_EXPIRY_MINUTES=10
# Max verification attempts per code.
OTP_MAX_ATTEMPTS=5
# Digits per code.
OTP_CODE_DIGITS=6

# ── Read-model list limits ───────────────────────────────────────────────
ADMIN_TOP_PRODUCTS_LIMIT=6
ADMIN_RECENT_ORDERS_LIMIT=7
BLOG_LIST_LIMIT=50

# ── Third-party API base URLs ────────────────────────────────────────────
# (Secrets/keys for these live in the DB settings table, not here.)
RAZORPAY_API_BASE_URL=https://api.razorpay.com
DELHIVERY_PROD_TRACK_URL=https://track.delhivery.com
DELHIVERY_STAGING_TRACK_URL=https://staging-express.delhivery.com
DELHIVERY_PACKAGE_TRACK_URL=https://www.delhivery.com/track/package
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions

# ── HTTP / DB tuning ─────────────────────────────────────────────────────
# Outbound HTTP timeout for generic third-party calls (seconds).
HTTP_TIMEOUT_SECONDS=30
# Longer timeout for AI chat completions (seconds).
AI_HTTP_TIMEOUT_SECONDS=90
# Timeout for Delhivery label/manifest calls (seconds).
DELHIVERY_HTTP_TIMEOUT_SECONDS=45
# SQLite busy timeout (ms) — how long to wait on a locked DB.
DB_BUSY_TIMEOUT_MS=5000

# ── App metadata (OpenAPI docs + /api/health) ────────────────────────────
APP_TITLE=Gawdee API
APP_VERSION=1.0.0
APP_DESCRIPTION=FastAPI backend for Gawdee — natural foods and wellness brand
HEALTH_SERVICE_NAME=gawdee-api
