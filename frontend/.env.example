# ── Gawdee storefront (Next.js) ──────────────────────────────────────────
# Copy to `.env.local` for local dev:  cp .env.example .env.local
# (A plain `.env` with the same values also works; `.env.local` wins on overlap.)
#
# Where each variable is read (app code must use `@/config/env`, never
# `process.env` directly — see `src/config/env.ts`):
# • BUILD vars are read by `next.config.ts` at build/dev-server start.
# • SERVER vars are server-only (SSR / route handlers via `env.internalApiUrl`).
# • NEXT_PUBLIC_* vars are inlined into the browser bundle AT BUILD TIME —
#   rebuild (`npm run build`) after changing them.
#
# No PORT variable: dev server is always `npm run dev` → http://localhost:3000
# (override per-run with `npm run dev -- -p 3001`). No secrets live here —
# payments/AI/shipping keys are held by the backend (DB settings table).

# ── Build config (next.config.ts only) ───────────────────────────────────
# Backend origin that `/api/:path*` requests are rewritten (proxied) to.
BACKEND_ORIGIN=http://localhost:8001
# Extra hostnames allowed to open the dev UI (comma-separated, no scheme/port).
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# ── Server-only (never exposed to the browser) ───────────────────────────
# Backend base URL used by server components / route handlers (direct fetch).
INTERNAL_API_URL=http://127.0.0.1:8001/api

# ── Browser: API ─────────────────────────────────────────────────────────
# Browser API base — keep `/api` so calls go same-origin via the proxy above.
NEXT_PUBLIC_API_URL=/api

# ── Browser: third-party scripts ─────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_CHECKOUT_URL=https://checkout.razorpay.com/v1/checkout.js
NEXT_PUBLIC_LOTTIE_URL=https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie.min.js
NEXT_PUBLIC_CONFETTI_URL=https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js

# ── Browser: commerce display ────────────────────────────────────────────
# ISO-4217 currency code for `money()` formatting.
NEXT_PUBLIC_CURRENCY=INR
# Fallback free-shipping threshold / fee shown until backend /storefront loads.
NEXT_PUBLIC_DEFAULT_SHIPPING_THRESHOLD=999
NEXT_PUBLIC_DEFAULT_SHIPPING_FEE=99

# ── Browser: brand fallbacks (until backend /storefront settings load) ───
NEXT_PUBLIC_DEFAULT_BRAND_NAME=Gawdee
NEXT_PUBLIC_DEFAULT_BRAND_TAGLINE=Pure food, thoughtfully made.
NEXT_PUBLIC_DEFAULT_BRAND_LOGO=/assets/images/logo.png
NEXT_PUBLIC_DEFAULT_STORE_EMAIL=info@gawdee.com
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=918891066980
NEXT_PUBLIC_DEFAULT_HEADER_SHOP_LABEL=Shop Now
# Feature flags: 1 = on, 0 = off.
NEXT_PUBLIC_DEFAULT_AI_CHAT_ENABLED=1
NEXT_PUBLIC_DEFAULT_SITE_SHOW_WHATSAPP=1
